package templates


templ Home () {
<!DOCTYPE html>
<html lang="es" class="dark">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>EG4 Battery Monitor</title>
    <link href="/static/css/cube.css" rel="stylesheet">
    <link href="/static/css/monitor-screen.css" rel="stylesheet">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500&display=swap" rel="stylesheet">

    <!-- Datastar v1.0.3: a single module script is the entire client runtime. -->
    <script type="module" src="/static/js/datastar.js"></script>

</head>

<body>




<main id="monitor" >

    <div class="device">
        <div class="screen" data-init="@get('/batteryStatusStream',{openWhenHidden: true})" >

            <script>

                function set(p) {
                    const cube  = document.querySelector('.progress-cube');
                    const socPercentageElm  = document.getElementById('soc-percentage');
                    socPercentageElm.textContent = p + '%';

                    p = Math.max(0, Math.min(100, p));
                    cube.style.setProperty('--p', (p / 100).toFixed(4));
                    cube.classList.toggle('low', p < 20);
                }


                // Update State of Charge
                function updateSoc(soc_pct) {
                    set(soc_pct);
                }

                function updateVoltage(voltage_mv) {
                    const voltageElm  = document.getElementById('voltage');
                    voltageElm.textContent = voltage_mv + 'V';
                }

                function updateCurrent(current_ma) {
                    const currentElm  = document.getElementById('current');
                    currentElm.textContent = current_ma + 'A';
                }

                function updatePower(power_ma) {
                    const powerElm  = document.getElementById('power');
                    powerElm.textContent = power_ma + 'W';
                }

                function updateMode(mode) {
                    const statusElm  = document.getElementById('mode');
                    statusElm.textContent = mode;
                }

                function updateDateTime(datetime) {
                    const date = new Date(datetime);
                    console.log(date);
                    const datetimeElm  = document.getElementById('datetime');
                    datetimeElm.textContent = date.toDateString() + ' ' + date.toLocaleTimeString();
                }


                function updateFields(data){

                     updateSoc(data.soc_pct);
                     updateVoltage(data.pack_voltage_v);
                     updateCurrent(data.pack_current_a);
                     updateDateTime(data.timestamp)
                     updateMode(data.mode);
                     updatePower(data.power_w);


                }


            </script>



            <div class="logo"><div class="logo-circle">EG<span>4</span></div></div>
            <div class="datetime" id="datetime">2026-09-21 11:12</div>

            <!-- Left column -->
            <div class="col col-left">
                <div class="box">
                    <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round">
                        <circle cx="12" cy="12" r="4"/>
                        <path d="M12 1v3M12 20v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M1 12h3M20 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"/>
                    </svg>
                    <span class="label" id="mode"></span>
                </div>

                <div class="box">
                    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8">
                        <path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z"/>
                        <circle cx="12" cy="10" r="2.6"/>
                    </svg>
                    <span class="label" id="address">1</span>
                </div>

                <div class="box signal">
                    <span class="proto">CAN</span>
                    <svg width="34" height="30" viewBox="0 0 34 30" fill="#fff">
                        <rect x="1" y="20" width="5" height="9" rx="1"/>
                        <rect x="10" y="14" width="5" height="15" rx="1"/>
                        <rect x="19" y="8" width="5" height="21" rx="1"/>
                        <rect x="28" y="2" width="5" height="27" rx="1"/>
                    </svg>
                    <span class="label">EG4/LUX</span>
                </div>

                <div class="box signal">
                    <span class="proto">RS485</span>
                    <svg width="34" height="30" viewBox="0 0 34 30" fill="#fff">
                        <rect x="1" y="20" width="5" height="9" rx="1"/>
                        <rect x="10" y="14" width="5" height="15" rx="1"/>
                        <rect x="19" y="8" width="5" height="21" rx="1"/>
                        <rect x="28" y="2" width="5" height="27" rx="1"/>
                    </svg>
                    <span class="label">P01-EG4</span>
                </div>

                <div class="firmware">BMS: Z02T11<br>LCD: V1.3.1</div>
            </div>

            <!-- Center battery -->

            <div class="progress-cube col col-mid" >

                <div class="glow"></div>

                <div class="scene">
                    <div class="cube">
                        <div class="gface g-back"></div>
                        <div class="gface g-left"></div>
                        <div class="gface g-right"></div>
                        <div class="gface g-bottom"></div>

                        <!-- liquid box (inside the shell) -->
                        <div class="lface l-side l-back"></div>
                        <div class="lface l-side l-left"></div>
                        <div class="lface l-side l-right"></div>
                        <div class="lface l-side l-front">
                            <span class="bubble"></span>
                            <span class="bubble"></span>
                            <span class="bubble"></span>
                        </div>
                        <div class="lface l-top"></div>

                        <!-- front-facing glass drawn last so the fill reads through it -->
                        <div class="gface g-front"></div>
                        <div class="gface g-top"></div>
                    </div>
                </div>

                <div class="soc-label">
                    <span class="label" id="soc-percentage"></span>
                </div>

            </div>


            <!-- Right column -->
            <div class="col col-right">
                <div class="box">
                    <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 8 L12 18 L19 8"/><path d="M5 8 Q12 4 19 8"/>
                    </svg>
                    <span class="label" id="voltage"></span>
                </div>

                <div class="box">
                    <svg width="34" height="30" viewBox="0 0 30 22" fill="none" stroke="#fff" stroke-width="1.8">
                        <rect x="1.5" y="4" width="23" height="14" rx="2.5"/>
                        <rect x="26" y="8" width="2.6" height="6" rx="1" fill="#fff" stroke="none"/>
                        <rect x="4.2" y="7" width="4" height="8" rx="1" fill="#fff" stroke="none"/>
                        <rect x="9.4" y="7" width="4" height="8" rx="1" fill="#fff" stroke="none"/>
                        <rect x="14.6" y="7" width="4" height="8" rx="1" fill="#fff" stroke="none"/>
                    </svg>
                    <span class="label" id="capacity">280Ah</span>
                </div>

                <div class="box">
                    <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 11 A10 10 0 0 1 25 11" fill="none" stroke-width="2" stroke-linecap="round"/>
                        <path d="M11 28 L17 15 L23 28 M13.3 23 L20.7 23" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>

{{/*                        <path d="M4 15 A9 9 0 0 1 20 15"/>*/}}
{{/*                        <path d="M8.5 19 L12 9 L15.5 19 M9.7 15.5 h4.6"/>*/}}
                    </svg>
                    <span class="label" id="current">0.00A</span>
                </div>

                <div class="box">
                    <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.6">
                        <circle cx="12" cy="12" r="3.2"/>
                        <path d="M12 2.5v2.4M12 19.1v2.4M4.2 4.2l1.7 1.7M18.1 18.1l1.7 1.7M2.5 12h2.4M19.1 12h2.4M4.2 19.8l1.7-1.7M18.1 5.9l1.7-1.7"/>
                    </svg>
                    <span class="label" id="power"></span>
                </div>
            </div>

        </div>
    </div>


</main>

</body>


</html>
}