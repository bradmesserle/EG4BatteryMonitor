package templates


templ Home () {
<!DOCTYPE html>
<html lang="es" class="dark">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>EG4 Battery Monitor</title>
    <link href="/static/css/cube.css" rel="stylesheet">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500&display=swap" rel="stylesheet">

    <!-- Datastar v1.0.3: a single module script is the entire client runtime. -->
    <script type="module" src="/static/js/datastar.js"></script>

    <!-- Cube JS -->
    <script type="module" src="/static/js/cube.js"></script>

</head>

<body>

<main id="monitor" >

    <script>


        //Update the cube with the latest data
        function update(msg) {

            console.log(msg);

            const batteryInfo = JSON.parse(msg);

            console.log(batteryInfo.soc_pct);
            set(batteryInfo.soc_pct);

        }

    </script>


    <div class="stage" data-init="@get('/batteryStatusStream',{openWhenHidden: true})">
        <div class="glow"></div>

        <div class="scene">
            <div class="cube">
                <div class="gface g-back"></div>
                <div class="gface g-left"></div>
                <div class="gface g-right"></div>
                <div class="gface g-bottom"></div>

                <!-- liquid box (inside the shell) -->
                <div class="lface l-side l-back"></div>
                <div class="lface l-side l-left"></div>
                <div class="lface l-side l-right"></div>
                <div class="lface l-side l-front">
                    <span class="bubble"></span>
                    <span class="bubble"></span>
                    <span class="bubble"></span>
                </div>
                <div class="lface l-top"></div>

                <!-- front-facing glass drawn last so the fill reads through it -->
                <div class="gface g-front"></div>
                <div class="gface g-top"></div>
            </div>
        </div>

{{/*        <div class="readout" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">*/}}
{{/*            <div class="num"><span id="num">0</span><span class="pct">%</span></div>*/}}
{{/*            <div class="cap" id="cap">Loading</div>*/}}
{{/*        </div>*/}}

{{/*        <div class="controls">*/}}
{{/*            <input id="slider" class="slider" type="range" min="0" max="100" value="0" step="0.5" aria-label="Progress">*/}}
{{/*            <button id="run" class="run">Run</button>*/}}
{{/*        </div>*/}}
    </div>


</main>

</body>


</html>
}